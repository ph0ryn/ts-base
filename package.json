{
  "name": "ts-base",
  "private": true,
  "type": "module",
  "module": "src/index.ts",
  "scripts": {
    "check": "vp check",
    "fix": "vp check --fix",
    "format": "vp fmt",
    "lint": "vp lint",
    "preinstall": "node -e \"if (!require('node:path').basename(process.env.npm_execpath ?? '').startsWith('pnpm')) { console.error('Please use pnpm to install dependencies.'); process.exit(1); }\"",
    "postinstall": "vp config --no-agent",
    "precommit": "vp staged"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": "^22.22.1 || ^24.11.0 || >=26.0.0"
  },
  "packageManager": "pnpm@11.28.5"
}
